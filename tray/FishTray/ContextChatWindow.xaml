<Window x:Class="FishTray.ContextChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="识别当前窗口并闲聊" Width="520" Height="760"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="True" Topmost="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterScreen">

    <Border x:Name="Shell" Margin="14" CornerRadius="18" BorderThickness="1" BorderBrush="#2A3F7A" ClipToBounds="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{StaticResource Bg1}" Offset="0"/>
                <GradientStop Color="{StaticResource Bg0}" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="4" Direction="270" Opacity="0.55"/>
        </Border.Effect>

        <Grid x:Name="Inner">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 顶栏 -->
            <Grid x:Name="Header" Grid.Row="0" Height="46" Margin="18,0,10,0">
                <TextBlock Text="识别当前窗口并闲聊" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ToggleButton x:Name="PinButton" Style="{StaticResource PinDot}" VerticalAlignment="Center" ToolTip="固定在最前面（不会被别的窗口盖住）"/>
                    <Button x:Name="CloseButton" Style="{StaticResource Ghost}" Content="✕" VerticalAlignment="Center" Padding="10,4" Margin="4,0,0,0" ToolTip="收起来（Esc），下次从控制台再点开"/>
                </StackPanel>
            </Grid>

            <ScrollViewer x:Name="Scroller" Grid.Row="1" Margin="6,0,6,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="12,0,12,16">

                    <!-- 状态 -->
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardLineBrush}" BorderThickness="1" CornerRadius="14" Padding="16,12,16,14" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="她现在看到的是" Style="{StaticResource Caption}"/>
                                <TextBlock x:Name="StateBadge" Text="—" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                            </Grid>
                            <TextBlock x:Name="NowText" Text="—" FontSize="13.5" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <TextBlock x:Name="WhyText" Text="" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <TextBlock x:Name="TryNote" Text="" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource AccentBrush}" Visibility="Collapsed"/>
                            <Grid Margin="0,12,0,0">
                                <Button x:Name="TryButton" Style="{StaticResource PillAccent}" Content="现在试一句" HorizontalAlignment="Left"/>
                                <Button x:Name="LogButton" Style="{StaticResource Ghost}" Content="看日志" HorizontalAlignment="Right" Padding="12,5"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 节奏 -->
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardLineBrush}" BorderThickness="1" CornerRadius="14" Padding="16,12,16,14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="说话的频率" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                            <UniformGrid Columns="3" Margin="0,0,0,14">
                                <Button x:Name="QuietButton" Style="{StaticResource Ghost}" Content="安静" Margin="0,0,6,0"/>
                                <Button x:Name="NormalButton" Style="{StaticResource Ghost}" Content="正常" Margin="3,0,3,0"/>
                                <Button x:Name="ChattyButton" Style="{StaticResource Ghost}" Content="话多" Margin="6,0,0,0"/>
                            </UniformGrid>

                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0">
                                <Run Text="两次之间至少间隔"/><Run x:Name="GapRun" Text="  7 分钟" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="13"/>
                            </TextBlock>
                            <Slider x:Name="GapSlider" Style="{StaticResource StarSlider}" Minimum="1" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="5" Margin="0,2,0,10"/>

                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0">
                                <Run Text="一天最多说"/><Run x:Name="DayRun" Text="  40 句" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="13"/>
                            </TextBlock>
                            <Slider x:Name="DaySlider" Style="{StaticResource StarSlider}" Minimum="0" Maximum="200" TickFrequency="5" IsSnapToTickEnabled="True" SmallChange="5" LargeChange="20" Margin="0,2,0,10"/>

                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0">
                                <Run Text="换了个窗口等待大约"/><Run x:Name="SceneRun" Text="  30 秒" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="13"/><Run Text=" 生成语音"/>
                            </TextBlock>
                            <Slider x:Name="SceneSlider" Style="{StaticResource StarSlider}" Minimum="5" Maximum="120" TickFrequency="5" IsSnapToTickEnabled="True" SmallChange="5" LargeChange="15" Margin="0,2,0,10"/>

                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0">
                                <Run Text="办公 / 写代码 / 画图使用大约"/><Run x:Name="OfficeRun" Text="  3 分钟" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="13"/><Run Text=" 生成语音"/>
                            </TextBlock>
                            <Slider x:Name="OfficeSlider" Style="{StaticResource StarSlider}" Minimum="1" Maximum="15" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="2" Margin="0,2,0,10"/>

                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0">
                                <Run Text="同一个窗口内容至少间隔"/><Run x:Name="DupeRun" Text="  2 小时" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="13"/>
                            </TextBlock>
                            <Slider x:Name="DupeSlider" Style="{StaticResource StarSlider}" Minimum="30" Maximum="720" TickFrequency="30" IsSnapToTickEnabled="True" SmallChange="30" LargeChange="120" Margin="0,2,0,10"/>

                            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0">
                                <Run Text="安静时段（这段时间不主动说话）"/><Run x:Name="QuietRun" Text="  0 点 – 8 点" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="13"/>
                            </TextBlock>
                            <!-- 双圆圈的滑动条：两个圆分别拖"从几点"和"到几点"，外观和上面的 StarSlider 一样（代码里画，BuildQuietRange） -->
                            <Grid x:Name="QuietTrack" Height="30" Margin="0,2,0,0" Background="Transparent"/>
                        </StackPanel>
                    </Border>

                    <!-- 风格 -->
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardLineBrush}" BorderThickness="1" CornerRadius="14" Padding="16,12,16,14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="说话风格（提示词）" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                            <TextBox x:Name="StyleBox" Style="{StaticResource Input}" Height="96" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                            <WrapPanel Margin="0,8,0,0">
                                <Button x:Name="TplSharp" Style="{StaticResource ChipButton}" Content="毒舌"/>
                                <Button x:Name="TplSoft" Style="{StaticResource ChipButton}" Content="温柔"/>
                                <Button x:Name="TplGenki" Style="{StaticResource ChipButton}" Content="元气"/>
                                <Button x:Name="TplCool" Style="{StaticResource ChipButton}" Content="高冷"/>
                                <Button x:Name="TplClingy" Style="{StaticResource ChipButton}" Content="黏人"/>
                                <Button x:Name="TplReset" Style="{StaticResource ChipButton}" Content="清空"/>
                            </WrapPanel>

                            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0">
                                <Run Text="每次最多"/><Run x:Name="LinesRun" Text="  2 行" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="13"/>
                            </TextBlock>
                            <Slider x:Name="LinesSlider" Style="{StaticResource StarSlider}" Minimum="1" Maximum="3" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,2,0,10"/>

                            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,0">
                                <Run Text="每行不超过"/><Run x:Name="CharsRun" Text="  28 字" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="13"/>
                            </TextBlock>
                            <Slider x:Name="CharsSlider" Style="{StaticResource StarSlider}" Minimum="12" Maximum="60" TickFrequency="2" IsSnapToTickEnabled="True" Margin="0,2,0,12"/>

                            <Grid Margin="0,2" ToolTip="在台词前加〔动作〕，她说话时会跟着做表情">
                                <TextBlock Text="带表情动作" VerticalAlignment="Center"/>
                                <ToggleButton x:Name="SwActions" Style="{StaticResource Switch}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,2" ToolTip="最后一句顺口问你一句，方便搭话">
                                <TextBlock Text="结尾问一句" VerticalAlignment="Center"/>
                                <ToggleButton x:Name="SwAsk" Style="{StaticResource Switch}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,2" ToolTip="用实时语音（GPT-SoVITS）念出来；关掉就只出气泡不出声">
                                <TextBlock Text="出声（日语）" VerticalAlignment="Center"/>
                                <ToggleButton x:Name="SwSpeech" Style="{StaticResource Switch}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,2" ToolTip="把「你在用什么」写进 DSH 的提示词，让屋里的 AI 也知道">
                                <TextBlock Text="写进提示词（知情）" VerticalAlignment="Center"/>
                                <ToggleButton x:Name="SwInject" Style="{StaticResource Switch}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 哪些软件能看 -->
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardLineBrush}" BorderThickness="1" CornerRadius="14" Padding="16,12,16,14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="哪些软件能看" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,10" ToolTip="白名单：只有下面列出来的软件才会被看见、才会搭话">
                                <TextBlock Text="白名单（关掉＝全部软件都看）" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                <ToggleButton x:Name="SwRequireList" Style="{StaticResource Switch}" HorizontalAlignment="Right"/>
                            </Grid>

                            <StackPanel x:Name="AppsPanel"/>

                            <Grid Margin="0,8,0,0">
                                <TextBox x:Name="NewAppBox" Style="{StaticResource Input}" Height="34" VerticalContentAlignment="Center"/>
                                <TextBlock x:Name="NewAppHint" Text="输入进程名，比如 msedge" Style="{StaticResource Caption}" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            </Grid>
                            <WrapPanel Margin="0,8,0,0">
                                <Button x:Name="AddHereButton" Style="{StaticResource ChipButton}" Content="＋ 把现在这个窗口加进来"/>
                                <Button x:Name="AddTypedButton" Style="{StaticResource ChipButton}" Content="＋ 添加输入的进程名"/>
                                <Button x:Name="PickExeButton" Style="{StaticResource ChipButton}" Content="＋ 从电脑里选一个程序"/>
                            </WrapPanel>

                            <TextBlock Text="黑名单：这些软件的标题连读都不读" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,6"/>
                            <StackPanel x:Name="PrivatePanel"/>
                            <Grid Margin="0,8,0,0">
                                <TextBox x:Name="PrivateInput" Style="{StaticResource Input}" Height="34" VerticalContentAlignment="Center"/>
                                <TextBlock x:Name="PrivateHint" Text="输入进程名，比如 wechat" Style="{StaticResource Caption}" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            </Grid>
                            <WrapPanel Margin="0,8,0,0">
                                <Button x:Name="PrivateHereButton" Style="{StaticResource ChipButton}" Content="＋ 把现在这个窗口加进来"/>
                                <Button x:Name="PrivateAddButton" Style="{StaticResource ChipButton}" Content="＋ 添加输入的进程名"/>
                                <Button x:Name="PrivatePickButton" Style="{StaticResource ChipButton}" Content="＋ 从电脑里选一个程序"/>
                            </WrapPanel>

                            <TextBlock Text="标题里出现这些词就不说（用逗号隔开）" Style="{StaticResource Caption}" Margin="0,10,0,6" TextWrapping="Wrap"/>
                            <TextBox x:Name="BlockBox" Style="{StaticResource Input}" Height="58" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="SaveHint" Text="改完自动保存，4 秒内生效" Style="{StaticResource Caption}" Margin="6,0,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
