const TITLE_CUT = [
  /\s*和另外\s*\d+\s*个页面/gu,
  /\s*-\s*(Microsoft[\u200b\s]*Edge|Google Chrome|Mozilla Firefox|Brave|Vivaldi|Opera)\s*$/iu,
